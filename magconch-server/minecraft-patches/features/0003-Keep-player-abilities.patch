@@ -1979,6 +1979,7 @@ public class ServerGamePacketListenerImpl
         }
 
         this.player.teleportSetPosition(destination, relatives);
+        this.player.gameMode.checkFlying(); // Magconch - keep player abilities
         this.awaitingPositionFromClient = this.player.position();
         // CraftBukkit start - update last location
         this.lastPosX = this.awaitingPositionFromClient.x;
diff --git a/net/minecraft/world/entity/player/Abilities.java b/net/minecraft/world/entity/player/Abilities.java
index 71c63c5eabb9a4214033562ef2fdc0a0d2243f30..849b01be1a0e6b13aa231ddffc439169204674a9 100644
--- a/net/minecraft/world/entity/player/Abilities.java
+++ b/net/minecraft/world/entity/player/Abilities.java
@@ -24,6 +24,18 @@ public class Abilities {
         return this.flyingSpeed;
     }
 
+    // Magconch start - keep player abilities
+    public void restoreFrom(final Abilities that) {
+        this.invulnerable = that.invulnerable;
+        this.flying = that.flying;
+        this.mayfly = that.mayfly;
+        this.instabuild = that.instabuild;
+        this.mayBuild = that.mayBuild;
+        this.flyingSpeed = that.flyingSpeed;
+        this.walkingSpeed = that.walkingSpeed;
+    }
+    // Magconch end - keep player abilities
+
     public void setFlyingSpeed(final float value) {
         this.flyingSpeed = value;
     }
