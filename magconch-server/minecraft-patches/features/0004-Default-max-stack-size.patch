diff --git a/net/minecraft/world/item/ItemStackTemplate.java b/net/minecraft/world/item/ItemStackTemplate.java
index c5f50a6cc901e4252c2705b5b195787372e325ca..e4c8480b0fe31cfaad1710d7288161a477545a37 100644
--- a/net/minecraft/world/item/ItemStackTemplate.java
+++ b/net/minecraft/world/item/ItemStackTemplate.java
@@ -22,20 +22,25 @@ public record ItemStackTemplate(Holder<Item> item, @Override int count, DataComp
         i -> i.group(
                 Item.CODEC.fieldOf("id").forGetter(ItemStackTemplate::item),
                 ExtraCodecs.intRange(1, 99).optionalFieldOf("count", 1).forGetter(ItemStackTemplate::count),
-                DataComponentPatch.CODEC.optionalFieldOf("components", DataComponentPatch.EMPTY).forGetter(ItemStackTemplate::components)
+                DataComponentPatch.CODEC.optionalFieldOf("components", DataComponentPatch.EMPTY).forGetter(t -> ItemStack.REMOTE_HASH.get() ? t.getRemoteComponentsPatch() : t.components()) // magconch - customize default components
             )
             .apply(i, ItemStackTemplate::new)
     );
     public static final Codec<ItemStackTemplate> CODEC = Codec.withAlternative(MAP_CODEC.codec(), Item.CODEC, item -> new ItemStackTemplate(item.value()));
-    public static final StreamCodec<RegistryFriendlyByteBuf, ItemStackTemplate> STREAM_CODEC = StreamCodec.composite(
-        Item.STREAM_CODEC,
-        ItemStackTemplate::item,
-        ByteBufCodecs.VAR_INT,
-        ItemStackTemplate::count,
-        DataComponentPatch.STREAM_CODEC,
-        ItemStackTemplate::components,
-        ItemStackTemplate::new
+    // magconch start - customize default components
+    public static final StreamCodec<RegistryFriendlyByteBuf, ItemStackTemplate> STREAM_CODEC = StreamCodec.of(
+        (output, template) -> {
+            Item.STREAM_CODEC.encode(output, template.item());
+            ByteBufCodecs.VAR_INT.encode(output, template.count());
+            DataComponentPatch.STREAM_CODEC.encode(output, template.getRemoteComponentsPatch());
+        },
+        input -> new ItemStackTemplate(
+            Item.STREAM_CODEC.decode(input),
+            ByteBufCodecs.VAR_INT.decode(input),
+            DataComponentPatch.STREAM_CODEC.decode(input)
+        )
     );
+    // magconch end - customize default components
 
     public ItemStackTemplate(final Item item) {
         this(item.builtInRegistryHolder(), 1, DataComponentPatch.EMPTY);
@@ -116,4 +121,26 @@ public record ItemStackTemplate(Holder<Item> item, @Override int count, DataComp
     public <T> @Nullable T get(final DataComponentType<? extends T> type) {
         return this.components.get(this.item.components(), type);
     }
+
+    // magconch start - customize default components
+    public DataComponentPatch getRemoteComponentsPatch() {
+        DataComponentPatch.Builder builder = DataComponentPatch.builder();
+        builder.copy(this.item.value().componentsPatchRemote());
+
+        DataComponentPatch.SplitResult split = this.components.split();
+        for (net.minecraft.core.component.TypedDataComponent<?> component : split.added()) {
+            if (!net.minecraft.core.component.DataComponents.UNABLE_SEND_TO_CLIENT.contains(component.type())) {
+                builder.set(component);
+            }
+        }
+
+        for (DataComponentType<?> type : split.removed()) {
+            if (!net.minecraft.core.component.DataComponents.UNABLE_SEND_TO_CLIENT.contains(type)) {
+                builder.remove(type);
+            }
+        }
+
+        return builder.build();
+    }
+    // magconch end - customize default components
 }
