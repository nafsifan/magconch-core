     public boolean shouldRender(final double camX, final double camY, final double camZ) {
         return true;
     }
+
+    // magconch start - adjust enchantment
+    private void changeLightningTimes(double x, double y, double z) {
+        if (this.getWeaponItem() != null) {
+            int channeling = 0;
+            net.minecraft.world.item.enchantment.ItemEnchantments enchantments = this.getWeaponItem().getOrDefault(net.minecraft.core.component.DataComponents.ENCHANTMENTS, net.minecraft.world.item.enchantment.ItemEnchantments.EMPTY);
+            for (net.minecraft.core.Holder<net.minecraft.world.item.enchantment.Enchantment> holder : enchantments.keySet()) {
+                if (holder.is(net.minecraft.world.item.enchantment.Enchantments.CHANNELING)) {
+                    channeling = enchantments.getLevel(holder);
+                    break;
+                }
+            }
+            if (channeling > 1) {
+                java.util.List<net.minecraft.world.entity.LightningBolt> list = com.google.common.collect.Lists.newArrayList();
+                this.level().getEntities(EntityTypes.LIGHTNING_BOLT, new net.minecraft.world.phys.AABB(x, y, z, x, y, z).inflate(1.0E-5), lightningBolt -> {
+                    return lightningBolt.tickCount == 0 && lightningBolt.times == 1;
+                }, list, 1);
+                if (!list.isEmpty()) {
+                    list.getFirst().times = channeling;
+                }
+            }
+        }
+    }
+
+    public long updateTridentTicket() {
+        if (this.level() instanceof ServerLevel serverLevel) {
+            net.minecraft.world.level.ChunkPos chunkPos = this.chunkPosition();
+            serverLevel.resetEmptyTime();
+            serverLevel.getChunkSource().addTicketWithRadius(net.minecraft.server.level.TicketType.TRIDENT, chunkPos, 2);
+            return net.minecraft.server.level.TicketType.TRIDENT.timeout() - 1L;
+        }
+        return 0L;
+    }
+
+    @Override
+    protected void onBelowWorld() {
+        if (this.getLoyalty() > 0) {
+            if (!this.dealtDamage) this.ticketCheck = new net.minecraft.world.phys.AABB(this.blockPosition());
+            this.dealtDamage = true;
+        } else {
+            super.onBelowWorld();
+        }
+    }
+    // magconch end - adjust enchantment
 }
