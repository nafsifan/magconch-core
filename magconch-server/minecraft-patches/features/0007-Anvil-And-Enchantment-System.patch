diff --git a/net/minecraft/world/damagesource/CombatRules.java b/net/minecraft/world/damagesource/CombatRules.java
index 9cc810a308c9b9581ced90e31afc36f5f39bb950..d8a65bf84303a9c6e7891b5394fa0462de14dfde 100644
--- a/net/minecraft/world/damagesource/CombatRules.java
+++ b/net/minecraft/world/damagesource/CombatRules.java
@@ -32,7 +32,11 @@ public class CombatRules {
     }
 
     public static float getDamageAfterMagicAbsorb(final float damage, final float totalMagicArmor) {
-        float realArmor = Mth.clamp(totalMagicArmor, 0.0F, 20.0F);
-        return damage * (1.0F - realArmor / 25.0F);
+        // magconch start - adjust enchantment: 平滑双曲衰减公式，消除 80% 硬上限
+        if (totalMagicArmor > 0.0F) {
+            return damage * (1.0F - (totalMagicArmor / (totalMagicArmor + 20.0F)));
+        }
+        return damage;
+        // magconch end - adjust enchantment
     }
 }
