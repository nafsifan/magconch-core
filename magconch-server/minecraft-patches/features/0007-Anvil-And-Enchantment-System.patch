+    // magconch start - anvil adjust: rename colors
+    private @Nullable Component renameColors() {
+        if (this.player == null || this.itemName == null) return null;
+
+        org.bukkit.craftbukkit.entity.CraftHumanEntity bukkitPlayer = this.player.getBukkitEntity();
+        String name = this.itemName;
+        boolean removeItalics = false;
+        if (bukkitPlayer.hasPermission("magconch.anvil.remove_italics") || !bukkitPlayer.isPermissionSet("magconch.anvil.remove_italics")) {
+            if (name.startsWith("&r")) {
+                name = name.substring(2);
+                removeItalics = true;
+            } else if (name.startsWith("<reset>")) {
+                name = name.substring(7);
+                removeItalics = true;
+            }
+        }
+
+        net.kyori.adventure.text.Component component;
+        boolean allowMiniMessage = bukkitPlayer.hasPermission("magconch.anvil.minimessage") || !bukkitPlayer.isPermissionSet("magconch.anvil.minimessage");
