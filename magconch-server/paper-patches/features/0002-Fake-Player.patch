Subject: [PATCH] Fake Player


diff --git a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
index 0b35a293f3436bcf8a39c4f07a88340cd9d33bcb..f8f643646f49dd8783437a7d9ed2902f4f57c90e 100644
--- a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
+++ b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
@@ -392,4 +392,19 @@ public class GlobalConfiguration extends ConfigurationPart {
     public class UpdateChecker extends ConfigurationPart {
         public boolean enabled = true;
     }
+
+    // magconch start - bot configuration
+    public MagconchConfig magconch;
+
+    public class MagconchConfig extends ConfigurationPart {
+        public Bot bot;
+
+        public class Bot extends ConfigurationPart {
+            public boolean enable = true;
+            public int playerLimit = 2;
+            public boolean resident = true;
+            public int timeoutHours = 24;
+        }
+    }
+    // magconch end - bot configuration
 }
diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
index 8b7a15af1eb2cc0318e26d7199c8e684de63cd72..1712f9893dc1de27739e19c7bf4cb1eea7d32776 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
@@ -40,6 +40,20 @@ class PaperEventManager {
             throw new IllegalStateException(event.getEventName() + " may only be triggered synchronously.");
         }
 
+        // magconch start - skip bot player events & manage resident bot life cycle
+        if (event instanceof org.bukkit.event.player.PlayerEvent playerEvent && playerEvent.getPlayer() instanceof org.magconch.entity.bot.Bot) {
+            return;
+        }
+
+        if (org.magconch.bot.BotConfig.enable && org.magconch.bot.BotConfig.canResident) {
+            if (event instanceof org.bukkit.event.world.WorldLoadEvent worldLoadEvent) {
+                org.magconch.bot.BotList.INSTANCE.loadResume(worldLoadEvent.getWorld().getUID().toString());
+            } else if (event instanceof org.bukkit.event.world.WorldUnloadEvent worldUnloadEvent) {
+                org.magconch.bot.BotList.INSTANCE.removeAllIn(worldUnloadEvent.getWorld().getUID().toString());
+            }
+        }
+        // magconch end - skip bot player events & manage resident bot life cycle
+
         HandlerList handlers = event.getHandlers();
         RegisteredListener[] listeners = handlers.getRegisteredListeners();
 
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftRegionAccessor.java b/src/main/java/org/bukkit/craftbukkit/CraftRegionAccessor.java
index 40a49c50b0d468ebdcd5c9b9753c2a8b3c8e1116..bedde3ca8311e43e2c9e8a263e0426ca88b8e240 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftRegionAccessor.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftRegionAccessor.java
@@ -375,6 +375,7 @@ public abstract class CraftRegionAccessor implements RegionAccessor {
     @SuppressWarnings("unchecked")
     public <T extends Entity> T addEntity(T entity) {
         Preconditions.checkArgument(!entity.isInWorld(), "Entity has already been added to a world");
+        Preconditions.checkState(!(entity instanceof org.magconch.entity.bot.CraftBot), "[magconch] Fakeplayers do not support changing world, Please use fakeplayer-api instead!");
         net.minecraft.world.entity.Entity nmsEntity = ((CraftEntity) entity).getHandle();
         if (nmsEntity.level() != this.getHandle().getLevel()) {
             throw new IllegalArgumentException(entity + " wasn't created with this world, you must create the entity with the world you want to add it to.");
