@@ -460,6 +461,7 @@ public final class CraftServer implements Server {
         this.potionBrewer = new io.papermc.paper.potion.PaperPotionBrewer(console); // Paper - custom potion mixes
         datapackManager = new io.papermc.paper.datapack.PaperDatapackManager(console.getPackRepository()); // Paper
         this.spark = new io.papermc.paper.SparksFly(this); // Paper - spark
+        this.botManager = new org.magconch.entity.bot.CraftBotManager(); // Magconch - bot
     }
 
     public boolean getCommandBlockOverride(String command) {
@@ -1317,7 +1319,7 @@ public final class CraftServer implements Server {
             return false;
         }
 
-        if (!handle.players().isEmpty()) {
+        if (!handle.realPlayers().isEmpty()) {
             return false;
         }
 
@@ -2951,4 +2953,11 @@ public final class CraftServer implements Server {
     public void allowPausing(final Plugin plugin, final boolean value) {
         this.console.addPluginAllowingSleep(plugin.getName(), value);
     }
+
+    // Magconch start - Bot API
+    @Override
+    public org.magconch.entity.bot.CraftBotManager getBotManager() {
+        return botManager;
+    }
+    // Magconch end - Bot API
 }
